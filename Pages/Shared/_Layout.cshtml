@{
    var usuario = Context.Session.GetString("usuario");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/logo-navbar.png" />
    <title>@ViewData["Title"] - Asesoría Legal Global</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark barra-nav">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                    <img src="~/images/logo-navbar.png" alt="Logo de Asesoría Legal Global" class="logo-nav" />
                    <span class="marca-texto">Asesoría Legal Global</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Registro">Registro</a>
                        </li>
                        @if (usuario == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login">Iniciar sesión</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Documentos">Mis documentos</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link texto-usuario">Hola, @usuario</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link enlace-salir" asp-page="/Salir">Cerrar sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container contenido">
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="container">
            <div class="row gy-3">
                <div class="col-12 col-md-4">
                    <img src="~/images/logo-banner.png" alt="Asesoría Legal Global" class="logo-pie" />
                </div>
                <div class="col-12 col-md-4">
                    <h6>Contacto</h6>
                    <p class="small mb-1">Av. Siempre Legal 123, Córdoba Capital</p>
                    <p class="small mb-1">Teléfono: 3518050743</p>
                    <p class="small mb-0">consultas@asesorialegalglobal.com</p>
                </div>
                <div class="col-12 col-md-4">
                    <h6>Enlaces</h6>
                    <p class="small mb-1"><a asp-page="/Index">Inicio</a></p>
                    <p class="small mb-1"><a asp-page="/Registro">Registro de clientes</a></p>
                    <p class="small mb-0"><a asp-page="/Privacy">Política de privacidad</a></p>
                </div>
            </div>
            <hr />
            <p class="small text-center mb-0">&copy; @DateTime.Now.Year - Asesoría Legal Global - Todos los derechos reservados</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
