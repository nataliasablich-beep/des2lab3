@page
@model PrivacyModel
@{
    ViewData["Title"] = "Política de privacidad";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="tarjeta shadow-sm">
            <h1 class="titulo-seccion h3">Política de privacidad</h1>
            <p>
                Asesoría Legal Global utiliza los datos que usted ingresa en el formulario de registro
                únicamente para identificarlo dentro del sitio y para habilitar la gestión de sus
                documentos legales.
            </p>
            <p>
                El nombre de usuario se guarda en la sesión del navegador y la contraseña en una cookie.
                Los archivos que usted carga quedan almacenados en una carpeta privada asociada a su usuario.
            </p>
            <p class="mb-0">
                Si desea eliminar su cuenta y sus documentos, puede solicitarlo escribiendo a
                consultas@asesorialegalglobal.com.
            </p>
        </div>
    </div>
</div>
